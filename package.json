{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "tokens": "node tools/generate-tokens.ts",
    "tokens:check": "node tools/generate-tokens.ts --check",
    "messages:check": "node tools/check-messages.ts",
    "lint": "eslint .",
    "lint:selftest": "node tools/eslint/selftest.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shots": "node tools/shots.ts",
    "verify": "pnpm check:node && pnpm tokens:check && pnpm messages:check && pnpm lint && pnpm lint:selftest && pnpm typecheck && pnpm format:check && pnpm build && pnpm test",
    "check:node": "node ../../scripts/check-node.mjs",
    "serve": "node tools/serve-out.ts",
    "test": "playwright test",
    "hero:image": "node tools/hero-image.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
